{
  "name": "fast-mapper",
  "version": "0.1.0",
  "description": "通用格線／底圖地圖繪製工具（Fast_mapper）",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@preact/signals": "^1.3.1",
    "idb": "^8.0.0",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.2"
  }
}
